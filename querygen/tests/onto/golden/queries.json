  "days_of_inventory_period": {
    "decimal": true,
    "derive": [
      {
        "alias": "days_of_inventory",
        "formula": "stock_value * 30 / cogs",
        "zero_division": "null"
      }
    ],
    "merge": null,
    "metric": "days_of_inventory",
    "object": "stock_valuation",
    "page": 1,
    "params": {},
    "path": "matrix",
    "period": {
      "from": "2026-09-01",
      "to": "2026-09-30"
    },
    "previous_request": null,
    "release": "6ff00e99f7ed52edee7c286aface0b67089b08fa8600ac8ec4d0e961183f486b",
    "request": {
      "analytic_type": "matrix",
      "matrix_col_dim": {
        "field_name": "1",
        "grain": "value"
      },
      "matrix_measures": [
        {
          "aggregation": "sum",
          "alias": "cogs",
          "field_name": "CASE WHEN \"layer_quantity\" < 0 AND \"scrapped\" IS NOT TRUE AND \"layer_date\" >= '2026-09-01' AND \"layer_date\" < '2026-10-01' THEN (-\"value\") END"
        },
        {
          "aggregation": "sum",
          "alias": "stock_value",
          "field_name": "remaining_value"
        }
      ],
      "matrix_row_dims": [],
      "pre_defined_filter_conditions": "WHERE _onto_id IN (SELECT id FROM onto_visible)",
      "sql_view_name": "wad_onto_stock_valuation_view"
    },
    "row_cap": 5000,
    "top_n": null
  },
