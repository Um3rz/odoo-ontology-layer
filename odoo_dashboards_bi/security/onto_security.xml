<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onto" model="ir.module.category">
        <field name="name">Onto Inventory Manager</field>
        <field name="sequence">50</field>
    </record>

    <!-- Branch managers read the results of the branches on their own user record.
         Regional managers, stewards and admins inherit that by implication. -->
    <record id="group_onto_branch_manager" model="res.groups">
        <field name="name">Onto Branch Manager</field>
        <field name="category_id" ref="module_category_onto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_onto_regional_manager" model="res.groups">
        <field name="name">Onto Regional Manager</field>
        <field name="category_id" ref="module_category_onto"/>
        <field name="implied_ids" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="group_onto_steward" model="res.groups">
        <field name="name">Onto Steward</field>
        <field name="category_id" ref="module_category_onto"/>
        <field name="implied_ids" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="group_onto_inventory_admin" model="res.groups">
        <field name="name">Onto Inventory Admin</field>
        <field name="category_id" ref="module_category_onto"/>
        <field name="implied_ids" eval="[(4, ref('odoo_dashboards_bi.group_onto_steward'))]"/>
    </record>
    <record id="group_onto_bot" model="res.groups">
        <field name="name">Onto Bot</field>
        <field name="category_id" ref="module_category_onto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('odoo_dashboards_bi.group_onto_inventory_admin'))]"/>
    </record>

    <!-- Multi-company: every Onto model, for everyone except superuser. -->
    <record id="rule_onto_audit_company" model="ir.rule">
        <field name="name">Onto audit: companies</field>
        <field name="model_id" ref="model_onto_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_policy_company" model="ir.rule">
        <field name="name">Onto policy: companies</field>
        <field name="model_id" ref="model_onto_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_rule_company" model="ir.rule">
        <field name="name">Onto rule: companies</field>
        <field name="model_id" ref="model_onto_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_authority_company" model="ir.rule">
        <field name="name">Onto authority: companies</field>
        <field name="model_id" ref="model_onto_authority"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_route_company" model="ir.rule">
        <field name="name">Onto route: companies</field>
        <field name="model_id" ref="model_onto_route"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_channel_company" model="ir.rule">
        <field name="name">Onto channel: companies</field>
        <field name="model_id" ref="model_onto_channel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_event_company" model="ir.rule">
        <field name="name">Onto event: companies</field>
        <field name="model_id" ref="model_onto_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_agent_setting_company" model="ir.rule">
        <field name="name">Onto agent setting: companies</field>
        <field name="model_id" ref="model_onto_agent_setting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_status_company" model="ir.rule">
        <field name="name">Onto status: companies</field>
        <field name="model_id" ref="model_onto_status"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_forecast_company" model="ir.rule">
        <field name="name">Onto forecast: companies</field>
        <field name="model_id" ref="model_onto_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_kpi_daily_company" model="ir.rule">
        <field name="name">Onto KPI: companies</field>
        <field name="model_id" ref="model_onto_kpi_daily"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_recommendation_company" model="ir.rule">
        <field name="name">Onto recommendation: companies</field>
        <field name="model_id" ref="model_onto_recommendation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_recommendation_line_company" model="ir.rule">
        <field name="name">Onto recommendation line: companies</field>
        <field name="model_id" ref="model_onto_recommendation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_alert_company" model="ir.rule">
        <field name="name">Onto alert: companies</field>
        <field name="model_id" ref="model_onto_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_stock_daily_company" model="ir.rule">
        <field name="name">Onto stock history: companies</field>
        <field name="model_id" ref="model_onto_stock_daily"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_chat_thread_company" model="ir.rule">
        <field name="name">Onto chat thread: companies</field>
        <field name="model_id" ref="model_onto_chat_thread"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_chat_message_company" model="ir.rule">
        <field name="name">Onto chat message: companies</field>
        <field name="model_id" ref="model_onto_chat_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onto_agent_run_company" model="ir.rule">
        <field name="name">Onto agent run: companies</field>
        <field name="model_id" ref="model_onto_agent_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onto_org_map_company" model="ir.rule">
        <field name="name">Onto org map: companies</field>
        <field name="model_id" ref="model_onto_org_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onto_parity_suspension_company" model="ir.rule">
        <field name="name">Onto parity suspension: companies</field>
        <field name="model_id" ref="model_onto_parity_suspension"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onto_object_setting_company" model="ir.rule">
        <field name="name">Onto object setting: companies</field>
        <field name="model_id" ref="model_onto_object_setting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onto_health_company" model="ir.rule">
        <field name="name">Onto health: companies</field>
        <field name="model_id" ref="model_onto_health"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Branch scope: results show only the branches (warehouses) on the user's record. -->
    <record id="rule_onto_status_branch" model="ir.rule">
        <field name="name">Onto status: own branches</field>
        <field name="model_id" ref="model_onto_status"/>
        <field name="domain_force">[('location_id.warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_forecast_branch" model="ir.rule">
        <field name="name">Onto forecast: own branches</field>
        <field name="model_id" ref="model_onto_forecast"/>
        <field name="domain_force">[('location_id.warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_kpi_daily_branch" model="ir.rule">
        <field name="name">Onto KPI: own branches</field>
        <field name="model_id" ref="model_onto_kpi_daily"/>
        <field name="domain_force">[('warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_recommendation_branch" model="ir.rule">
        <field name="name">Onto recommendation: own branches</field>
        <field name="model_id" ref="model_onto_recommendation"/>
        <field name="domain_force">[('warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_recommendation_line_branch" model="ir.rule">
        <field name="name">Onto recommendation line: own branches</field>
        <field name="model_id" ref="model_onto_recommendation_line"/>
        <field name="domain_force">[('recommendation_id.warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_alert_branch" model="ir.rule">
        <field name="name">Onto alert: own branches</field>
        <field name="model_id" ref="model_onto_alert"/>
        <field name="domain_force">[('location_id.warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_stock_daily_branch" model="ir.rule">
        <field name="name">Onto stock history: own branches</field>
        <field name="model_id" ref="model_onto_stock_daily"/>
        <field name="domain_force">[('location_id.warehouse_id', 'in', user.onto_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>

    <!-- Chat and agent records: each user sees their own. Stewards see system runs (playbooks, jobs). -->
    <record id="rule_onto_chat_thread_own" model="ir.rule">
        <field name="name">Onto chat threads: own</field>
        <field name="model_id" ref="model_onto_chat_thread"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_chat_message_own" model="ir.rule">
        <field name="name">Onto chat messages: own</field>
        <field name="model_id" ref="model_onto_chat_message"/>
        <field name="domain_force">[('thread_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager'))]"/>
    </record>
    <record id="rule_onto_agent_run_own" model="ir.rule">
        <field name="name">Onto agent runs: own</field>
        <field name="model_id" ref="model_onto_agent_run"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_branch_manager')), (4, ref('odoo_dashboards_bi.group_onto_bot'))]"/>
    </record>
    <record id="rule_onto_agent_run_system" model="ir.rule">
        <field name="name">Onto agent runs: system runs for stewards</field>
        <field name="model_id" ref="model_onto_agent_run"/>
        <field name="domain_force">[('kind', 'in', ['playbook', 'job'])]</field>
        <field name="groups" eval="[(4, ref('odoo_dashboards_bi.group_onto_steward'))]"/>
    </record>
</odoo>
